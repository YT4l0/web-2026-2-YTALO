# Modo de autenticação: 'mock' (offline/local) ou 'cognito' (AWS Cognito Hosted UI)
VITE_AUTH_MODE=mock

# Configurações do AWS Cognito User Pool
# Preencha ao alternar VITE_AUTH_MODE para 'cognito'
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=

# Domínio do Cognito Hosted UI (sem https://)
# Exemplo: meu-app.auth.sa-east-1.amazoncognito.com
VITE_COGNITO_DOMAIN=

# URLs de redirecionamento (devem bater com o configurado no App Client do Cognito)
VITE_COGNITO_REDIRECT_SIGN_IN=http://localhost:5173/
VITE_COGNITO_REDIRECT_SIGN_OUT=http://localhost:5173/
