# Modo de autenticação: 'mock' (offline/local) ou 'cognito' (AWS Cognito Hosted UI)
VITE_AUTH_MODE=cognito

# Configurações do AWS Cognito User Pool
# Preencha ao alternar VITE_AUTH_MODE para 'cognito'
VITE_COGNITO_USER_POOL_ID=us-east-1_tIGBMIdPT
VITE_COGNITO_CLIENT_ID=6tq07p9kk1uoq1o0dq9t6kce8u

# Domínio do Cognito Hosted UI (sem https://)
# Exemplo: meu-app.auth.sa-east-1.amazoncognito.com
VITE_COGNITO_DOMAIN=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_tIGBMIdPT/.well-known/openid-configuration

# URLs de redirecionamento (devem bater com o configurado no App Client do Cognito)
VITE_COGNITO_REDIRECT_SIGN_IN=https://ytalodias.zangado.web.ufersa.dev.br/
VITE_COGNITO_REDIRECT_SIGN_OUT=https://ytalodias.zangado.web.ufersa.dev.br/
