{
  "name": "motorlocal-ai-agent",
  "version": "1.0.0",
  "description": "Agente de IA do MotorLocal — Strands Agents + Google Gemini",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node esbuild.config.mjs",
    "test": "vitest run --reporter=verbose",
    "package": "cd dist && powershell -NoProfile -Command \"Compress-Archive -Path handler.mjs -DestinationPath ../lambda.zip -Force\""
  },
  "dependencies": {
    "@aws-sdk/client-apigatewaymanagementapi": "^3.930.0",
    "@aws-sdk/client-dynamodb": "^3.930.0",
    "@aws-sdk/lib-dynamodb": "^3.930.0",
    "@google/genai": "^2.32.0",
    "@strands-agents/sdk": "^1.26.0",
    "aws-jwt-verify": "^4.0.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
